<mxfile host="app.diagrams.net">
  <diagram name="Blue-Green ECS Architecture" id="bluegreen-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="Zero-downtime blue-green deployment on ECS Fargate" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#161616;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- ================= EXTERNAL ACTORS (plain, non-AWS) ================= -->
        <!-- Real GitHub logo, embedded directly (verified SVG from the simple-icons
             project, CC0/MIT licensed) — not a guessed draw.io stencil name -->
        <mxCell id="github" value="GitHub repo&#10;pipeline-config/ branch: main" style="shape=image;image=data:image/svg+xml;base64,;fontColor=#232F3E;fontSize=12;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;imageBackground=#F2F3F3;imageBorder=#545B64;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="56" height="56" as="geometry" />
        </mxCell>

        <!-- Real AWS icon: mxgraph.aws4.users (verified standalone "crowd" icon,
             resource-level pattern — strokeColor=none, not the resourceIcon pattern) -->
        <mxCell id="endusers" value="End users&#10;normal browser traffic" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#545B64;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="1480" y="80" width="56" height="56" as="geometry" />
        </mxCell>

        <mxCell id="tester" value="You (testing)&#10;curl -H X-Bg-Test: true" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#545B64;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="1480" y="170" width="56" height="56" as="geometry" />
        </mxCell>

        <!-- ================= DEVELOPER TOOLS CHAIN (real AWS icons) ================= -->
        <mxCell id="codestar" value="CodeStar Connection" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#527FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codestar;" vertex="1" parent="1">
          <mxGeometry x="100" y="220" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- CodePipeline container -->
